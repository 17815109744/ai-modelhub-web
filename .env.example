# Server
NODE_ENV=development
PORT=5173
APP_URL=http://localhost:5173

# Storage mode:
# - local: current JSON database fallback for local demos
# - prisma: Supabase/Postgres via Prisma
DATA_BACKEND=prisma

# Supabase / Postgres
# Supabase project settings expose both pooled and direct URLs.
# Runtime uses PRISMA_DATABASE_URL first, then DIRECT_URL, then DATABASE_URL.
# Use DIRECT_URL/session pooler here if the transaction pooler on 6543 is unavailable.
PRISMA_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Auth verification
# For Supabase: https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
AUTH_JWKS_URL=""
AUTH_JWT_ISSUER=""
AUTH_JWT_AUDIENCE="authenticated"

# Credential encryption
# Generate a 32-byte base64 key:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_MASTER_KEY=""
CREDENTIAL_KEY_VERSION="v1"

# Privacy defaults
PRIVACY_DEFAULT_MODE=strict
STORE_MESSAGE_CONTENT=true
LOG_BODY_CONTENT=false

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Model provider keys for platform-owned fallback routes.
# User-owned keys should be stored in api_credentials, not env.
# Gemini is the easiest free-tier API test path for this project.
# Create a key in Google AI Studio, then paste it into GEMINI_API_KEY.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# Free local AI via Ollama.
# Install Ollama, then run: ollama pull qwen2.5:3b
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:3b"
