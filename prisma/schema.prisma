generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MemberRole {
  owner
  admin
  member
  auditor
}

enum CredentialHealth {
  unknown
  ok
  warn
  bad
}

enum PrivacyLevel {
  public
  internal
  confidential
  regulated
}

enum MessageRole {
  user
  assistant
  system
  tool
}

enum JobStatus {
  queued
  running
  completed
  failed
  canceled
}

enum BillingStatus {
  pending
  paid
  failed
  refunded
}

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  fullName  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships OrganizationMember[]
  credentials ApiCredential[]      @relation("CredentialCreator")
  prompts     PromptTemplate[]     @relation("PromptCreator")
  auditLogs   AuditLog[]           @relation("AuditActor")

  @@map("profiles")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members        OrganizationMember[]
  credentials    ApiCredential[]
  conversations  Conversation[]
  usageRecords   UsageRecord[]
  modelRequests  ModelRequest[]
  prompts        PromptTemplate[]
  settings       OrganizationSettings?
  knowledgeBases KnowledgeBase[]
  documents      Document[]
  batchJobs      BatchJob[]
  billingOrders  BillingOrder[]
  auditLogs      AuditLog[]

  @@map("organizations")
}

model OrganizationMember {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String     @db.Uuid
  userId    String     @db.Uuid
  role      MemberRole @default(member)
  createdAt DateTime   @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("organization_members")
}

model ApiCredential {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId              String           @db.Uuid
  createdById        String           @db.Uuid
  provider           String
  name               String
  preview            String
  fingerprintHash    String
  encryptedSecret    String
  iv                 String
  authTag            String
  aadHash            String
  algorithm          String           @default("AES-256-GCM")
  keyVersion         String
  health             CredentialHealth @default(unknown)
  healthDetail       String?
  balanceUsd         Decimal?         @db.Decimal(12, 4)
  lastCheckedAt      DateTime?
  revokedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy Profile      @relation("CredentialCreator", fields: [createdById], references: [id])

  @@unique([orgId, provider, fingerprintHash])
  @@index([orgId, provider])
  @@map("api_credentials")
}

model Conversation {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId        String       @db.Uuid
  userId       String       @db.Uuid
  title        String
  privacyLevel PrivacyLevel @default(internal)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  org      Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages Message[]
  requests ModelRequest[]

  @@index([orgId, updatedAt])
  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String      @db.Uuid
  role           MessageRole
  modelId        String?
  provider       String?
  contentCipher  String?
  contentIv      String?
  contentAuthTag String?
  contentPreview String?
  tokenCount     Int         @default(0)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model ModelRequest {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String       @db.Uuid
  conversationId String?      @db.Uuid
  provider       String
  modelId        String
  privacyLevel   PrivacyLevel @default(internal)
  statusCode     Int?
  errorCode      String?
  latencyMs      Int?
  inputTokens    Int          @default(0)
  outputTokens   Int          @default(0)
  costUsd        Decimal      @default(0) @db.Decimal(12, 6)
  createdAt      DateTime     @default(now())

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  usage        UsageRecord?

  @@index([orgId, createdAt])
  @@index([provider, modelId])
  @@map("model_requests")
}

model UsageRecord {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @db.Uuid
  requestId      String   @unique @db.Uuid
  date           DateTime @db.Date
  provider       String
  modelId        String
  inputTokens    Int
  outputTokens   Int
  totalTokens    Int
  costUsd        Decimal  @db.Decimal(12, 6)
  costCny        Decimal? @db.Decimal(12, 6)
  createdAt      DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  request ModelRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([orgId, date])
  @@index([orgId, provider, modelId])
  @@map("usage_records")
}

model BillingOrder {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String        @db.Uuid
  provider  String
  plan      String
  amountUsd Decimal       @db.Decimal(12, 2)
  status    BillingStatus @default(pending)
  metadata  Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
  @@map("billing_orders")
}

model OrganizationSettings {
  orgId     String   @id @db.Uuid
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model PromptTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String?  @db.Uuid
  createdById String?  @db.Uuid
  sourceId    String?
  title       String
  category    String
  body        String
  official    Boolean  @default(false)
  favorite    Boolean  @default(false)
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy Profile?      @relation("PromptCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orgId, category])
  @@unique([orgId, sourceId])
  @@map("prompt_templates")
}

model KnowledgeBase {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([orgId, updatedAt])
  @@map("knowledge_bases")
}

model Document {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId           String    @db.Uuid
  knowledgeBaseId String    @db.Uuid
  name            String
  mimeType        String
  sizeBytes       BigInt
  storageProvider String
  storageKey      String
  status          String    @default("queued")
  chunkCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  knowledgeBase KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  chunks        DocumentChunk[]

  @@index([orgId, knowledgeBaseId])
  @@map("documents")
}

model DocumentChunk {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId  String @db.Uuid
  orgId       String @db.Uuid
  chunkIndex  Int
  textCipher  String?
  textPreview String?
  tokenCount  Int    @default(0)
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([orgId])
  @@map("document_chunks")
}

model BatchJob {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String    @db.Uuid
  createdById String    @db.Uuid
  type        String
  modelId     String
  provider    String
  instruction String
  status      JobStatus @default(queued)
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items BatchJobItem[]

  @@index([orgId, createdAt])
  @@map("batch_jobs")
}

model BatchJobItem {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String    @db.Uuid
  rowNumber Int
  input     Json
  output    Json?
  status    JobStatus @default(queued)
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  job BatchJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, rowNumber])
  @@map("batch_job_items")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String?  @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  target    String?
  metadata  Json?
  ipHash    String?
  createdAt DateTime @default(now())

  org   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor Profile?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}
